<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_crops">

    <fragment
        android:id="@+id/navigation_crops"
        android:name="com.kiuda.app.presentation.crops.CropsFragment"
        android:label="나의 작물"
        tools:layout="@layout/fragment_crops" />

    <fragment
        android:id="@+id/navigation_growth"
        android:name="com.kiuda.app.presentation.growth.GrowthLogFragment"
        android:label="생육기록"
        tools:layout="@layout/fragment_growth_log" />

    <fragment
        android:id="@+id/navigation_sensor"
        android:name="com.kiuda.app.presentation.sensor.SensorAlertsFragment"
        android:label="센서 알림"
        tools:layout="@layout/fragment_sensor_alerts">
        <action
            android:id="@+id/action_sensor_to_ask"
            app:destination="@id/navigation_ask" />
    </fragment>

    <fragment
        android:id="@+id/navigation_ask"
        android:name="com.kiuda.app.presentation.ask.AskFragment"
        android:label="AI 묻다"
        tools:layout="@layout/fragment_ask">
        <argument
            android:name="sensorAlertContext"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

</navigation>
