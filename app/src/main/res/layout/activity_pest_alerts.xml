<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/kiuda_background"
    android:orientation="vertical">

    <!-- 1. 상단 앱바 -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:background="@color/kiuda_background"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/kiuda_background"
            app:title="센서 알림 &amp; 병해충 주의보"
            app:titleTextAppearance="@style/TextAppearance.Kiuda.TitleLarge"
            app:titleTextColor="@color/kiuda_text_primary"
            app:navigationIconTint="@color/kiuda_text_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="32dp">

                <!-- 2. 요약 카운터 헤더 카드 -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Kiuda.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="@dimen/radius_xlarge"
                    app:cardElevation="@dimen/elevation_card_low"
                    app:strokeColor="@color/kiuda_outline_variant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvAlertSummaryTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="🚨 실시간 실내/외 알림 현황"
                                android:textColor="@color/kiuda_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvSource"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="출처: 센서 Hub · NCPMS"
                                android:textColor="@color/kiuda_text_tertiary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- 위험도별 브레이크다운 카운트 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvBadgeHighCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_chip"
                                android:backgroundTint="@color/kiuda_error_container"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="위험 1건"
                                android:textColor="@color/kiuda_error"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvBadgeMedCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/bg_chip"
                                android:backgroundTint="@color/kiuda_warning_container"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="경고 1건"
                                android:textColor="@color/kiuda_warning"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvBadgeLowCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/bg_chip"
                                android:backgroundTint="@color/kiuda_info_container"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="정보 1건"
                                android:textColor="@color/kiuda_info"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. 동적 알림 리스트 헤더 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:text="📋 알림 및 주의보 리스트"
                    android:textColor="@color/kiuda_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- 동적 알림 카드가 추가되는 컨테이너 -->
                <LinearLayout
                    android:id="@+id/container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- 4. 빈 상태 UI -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/layoutEmptyState"
                    style="@style/Widget.Kiuda.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:cardCornerRadius="@dimen/radius_xlarge"
                    app:cardElevation="@dimen/elevation_card_low"
                    app:strokeColor="@color/kiuda_outline_variant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="32dp">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_kiuda_leaf"
                            app:tint="@color/kiuda_success" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="현재 주의가 필요한 알림이 없습니다 🌿"
                            android:textColor="@color/kiuda_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="모든 작물과 온습도 환경이 양호한 상태입니다."
                            android:textColor="@color/kiuda_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
