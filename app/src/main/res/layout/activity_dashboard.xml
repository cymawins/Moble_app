<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/kiuda_background">

    <!-- 상단 앱바 -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:background="@color/kiuda_background"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/kiuda_background"
            app:popupTheme="@style/ThemeOverlay.MaterialComponents.Light"
            app:title=""
            app:contentInsetStart="16dp"
            app:contentInsetStartWithNavigation="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivHeaderLogo"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="키:우다 로고"
                    android:src="@drawable/ic_kiuda_logo_icon" />

                <TextView
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="키:우다"
                    android:textColor="@color/kiuda_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 당겨서 새로고침 -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="20dp"
                android:paddingTop="12dp"
                android:paddingRight="20dp"
                android:paddingBottom="24dp">

                <!-- 1. 인사말 영역 (웹 통합 대시보드 톤) -->
                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.02"
                    android:text="오늘도 건강하게 자라고 있어요, 키움이님"
                    android:textColor="@color/kiuda_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="오늘의 초록빛 소식과 내 작물 상태입니다"
                    android:textColor="@color/kiuda_text_secondary"
                    android:textSize="13sp" />

                <!-- 2. 요약 카드 영역 (가로 2열: 날씨 & 센서/주의보 요약) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <!-- 날씨/환경 요약 카드 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_neo_card"
                        android:elevation="1dp"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="☀  오늘의 환경"
                            android:textColor="@color/kiuda_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvWeather"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="28°C / 맑음"
                            android:textColor="@color/kiuda_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 병해충/센서 요약 카드 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_neo_card"
                        android:elevation="1dp"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚠  병해충 센서"
                            android:textColor="@color/kiuda_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="주의보 (MEDIUM)"
                            android:textColor="@color/kiuda_warning"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

                <!-- 3. 내 키움이 (나의 작물) 섹션 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="-0.01"
                        android:text="🌱  내 키움이"
                        android:textColor="@color/kiuda_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- 키움이 등록 버튼 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddPlant"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ 키움이 등록"
                        android:textColor="@color/kiuda_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 내 키움이 동적 카드가 들어가는 리니어 레이아웃 -->
                <LinearLayout
                    android:id="@+id/containerPlants"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="48dp"
                    android:orientation="vertical" />

                <!-- 식물이 없을 때 빈 상태 안내 카드 -->
                <LinearLayout
                    android:id="@+id/tvNoPlants"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_neo_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_kiuda_leaf"
                        app:tint="@color/kiuda_text_tertiary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="아직 등록된 키움이가 없어요"
                        android:textColor="@color/kiuda_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="첫 키움이를 등록하고 정성껏 관리해보세요!"
                        android:textColor="@color/kiuda_text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRegisterFirstPlant"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/kiuda_primary"
                        android:text="+ 첫 키움이 등록하기"
                        android:textColor="@color/kiuda_on_primary"
                        android:textSize="14sp"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <!-- 4. 오늘의 할 일 (체크리스트) 섹션 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:letterSpacing="-0.01"
                    android:text="✅  오늘 할 일"
                    android:textColor="@color/kiuda_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/containerChecklist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_neo_card"
                    android:elevation="1dp"
                    android:minHeight="56dp"
                    android:orientation="vertical"
                    android:padding="16dp" />

                <!-- 5. 병해충 주의보 요약 목록 섹션 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:letterSpacing="-0.01"
                    android:text="⚠  병해충 정보 및 알림"
                    android:textColor="@color/kiuda_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/containerPest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_neo_card"
                    android:elevation="1dp"
                    android:minHeight="48dp"
                    android:orientation="vertical"
                    android:padding="14dp" />

                <!-- 주의보 및 도감 이동 2열 Outlined 버튼 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPestAlerts"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="주의보 전체보기"
                        android:textColor="@color/kiuda_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/kiuda_outline" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEncyclopedia"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="병해충 도감"
                        android:textColor="@color/kiuda_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/kiuda_outline" />
                </LinearLayout>

                <!-- 6. AI 온새미 묻다 Primary CTA 버튼 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAsk"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="32dp"
                    android:backgroundTint="@color/kiuda_primary"
                    android:elevation="2dp"
                    android:text="🤖  묻다 · AI 사진 진단하기"
                    android:textColor="@color/kiuda_on_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp" />

                <!-- 로딩 프로그레스바 -->
                <ProgressBar
                    android:id="@+id/progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:indeterminateTint="@color/kiuda_primary"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
