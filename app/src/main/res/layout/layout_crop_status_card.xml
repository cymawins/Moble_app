<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCropStatus"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/kiuda_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/kiuda_outline_variant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 작물 헤더 정보 (선택된 작물이 있을 때) -->
        <LinearLayout
            android:id="@+id/layoutPlantInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPlantIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌱"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPlantName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="방울토마토"
                    android:textColor="@color/kiuda_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPlantLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="베란다 가든 1구역"
                    android:textColor="@color/kiuda_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_soft"
                android:backgroundTint="@color/kiuda_warning_container"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="주의"
                android:textColor="@color/kiuda_warning"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 작물 미등록 상태 (선택된 작물이 없을 때) -->
        <LinearLayout
            android:id="@+id/layoutNoPlant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvNoPlantMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="작물을 먼저 등록해주세요"
                android:textColor="@color/kiuda_text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 센서 요약 수치 & 생육 정보 grid -->
        <LinearLayout
            android:id="@+id/layoutSensorMetrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pill_soft"
            android:backgroundTint="@color/kiuda_surface_variant"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSoilMoisture"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💧 토양 수분: 15% (부족)"
                    android:textColor="@color/kiuda_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTemperature"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🌡️ 온도: 29°C"
                    android:textColor="@color/kiuda_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvHumidity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💨 상대습도: 45%"
                    android:textColor="@color/kiuda_text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvGrowthStage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🌸 생육: 개화기 (35일차)"
                    android:textColor="@color/kiuda_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- "이 상태로 AI에게 묻기" 버튼 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAskWithStatus"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/kiuda_primary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="✨ 이 상태로 AI에게 묻기"
            android:textColor="@color/kiuda_on_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
