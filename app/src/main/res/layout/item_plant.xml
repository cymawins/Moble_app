<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_neo_card"
    android:elevation="1dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- 식물 원형 백그라운드 & 아이콘 -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_logo_circle"
        android:backgroundTint="@color/kiuda_primary_container">

        <ImageView
            android:id="@+id/iv_plant_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="작물 아이콘"
            android:src="@drawable/ic_kiuda_leaf"
            app:tint="@color/kiuda_primary" />
    </FrameLayout>

    <!-- 식물 닉네임 & 상세정보 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_plant_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="-0.01"
            android:text="방울토마토"
            android:textColor="@color/kiuda_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_plant_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="토마토  ·  베란다 정원"
            android:textColor="@color/kiuda_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 상태 칩 태그 -->
    <TextView
        android:id="@+id/tv_plant_status_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip"
        android:backgroundTint="@color/kiuda_primary_container"
        android:paddingLeft="10dp"
        android:paddingTop="4dp"
        android:paddingRight="10dp"
        android:paddingBottom="4dp"
        android:text="생육중"
        android:textColor="@color/kiuda_on_primary_container"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
