<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Drop Shadow -->
    <item android:left="1dp" android:top="2dp" android:right="1dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#0C000000" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Card Surface -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/kiuda_surface" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="@color/kiuda_outline_variant" />
        </shape>
    </item>
</layer-list>
